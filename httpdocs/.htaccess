# DASHFIX TuningPortal — Apache-config voor httpdocs (copy-paste, geen npm)
Options -Indexes
RewriteEngine On

# Bescherm gevoelige mappen
RewriteRule ^(data|uploads)(/|$) - [F,L]

# Bestaande bestanden/mappen direct serveren (assets, css, js)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Alles anders naar frontcontroller
RewriteRule ^ index.php [L]

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
