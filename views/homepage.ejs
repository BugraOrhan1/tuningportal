<%- include('partials/header') %>

<div class="hero">
  <div class="hero-inner">
    <div>
      <div class="credit-banner">
        <div>
          <h3>Buy 1 credit &nbsp; Get 1 free *!</h3>
          <p>* Max. 10 bonus credits per order • Valid only for new customers</p>
        </div>
        <div style="text-align:right">
          <div style="font-size:11px;opacity:.9">FAST TURNAROUND</div>
          <div style="font-weight:800">Ready within 5 min</div>
        </div>
      </div>
      <h1>High quality <span class="accent">ECU tuning files</span> delivered fast by experienced engineers.</h1>
      <p>Ready to flash. Tested on real vehicles. Dyno-proven gains. 24/7 support voor professionals.</p>
      <div class="hero-cta">
        <a href="/register" class="btn btn-primary">Register Now</a>
        <a href="/login" class="btn btn-ghost">NEW Login</a>
        <a href="/account/file-services/new-file-service" class="btn" style="background:#263238;color:#fff">OLD Login</a>
      </div>
      <div class="hero-badges">
        <div class="badge"><i class="fa fa-clock-o"></i><div><strong>FAST TURNAROUND</strong><span>Ready within 5 minutes</span></div></div>
        <div class="badge"><i class="fa fa-tachometer"></i><div><strong>DYNO-TESTED</strong><span>Tested on real vehicles</span></div></div>
        <div class="badge"><i class="fa fa-headphones"></i><div><strong>24/7 SUPPORT</strong><span>We're here to help</span></div></div>
      </div>
    </div>

    <!-- CONFIGURATOR -->
    <div class="configurator" id="configurator">
      <h3><i class="fa fa-car" style="color:var(--primary)"></i> Enhnance your vehicle's performance</h3>
      <p style="font-size:12px;color:#78909c;margin-bottom:12px">Kies je voertuig en bekijk direct hoeveel PK & Nm je wint — op basis van echte ECU data.</p>
      <div class="config-grid">
        <select id="hp-make"><option value="">Choose a make</option><% makes.forEach(m=>{ %><option value="<%= m.id %>"><%= m.name %></option><% }) %><option value="other">Otherwise, namely</option></select>
        <select id="hp-model" disabled><option value="">Choose a model</option></select>
        <select id="hp-generation" disabled><option value="">Choose a generation</option></select>
        <select id="hp-engine" disabled><option value="">Choose an engine</option></select>
        <button class="btn-search" id="hp-search"><i class="fa fa-search"></i> Search</button>
      </div>
      <div id="hp-result" class="power-card">
        <h4><i class="fa fa-line-chart"></i> <span id="hp-engine-name">2.0 TDI 150hp</span> <span style="margin-left:auto;font-size:11px;background:var(--primary);color:#fff;padding:2px 6px">Stage 1</span></h4>
        <div class="power-grid">
          <div class="power-item">
            <div class="label">Origineel</div>
            <div class="value" id="orig-hp">150 hp</div>
            <div style="font-size:11px;color:#78909c"><span id="orig-kw">110 kW</span> • <span id="orig-nm">340 Nm</span></div>
          </div>
          <div class="power-item" style="border-color:var(--primary);background:#fff7f3">
            <div class="label">Na tuning</div>
            <div class="value" id="tuned-hp" style="color:var(--primary)">185 hp</div>
            <div style="font-size:11px;color:#78909c"><span id="tuned-kw">136 kW</span> • <span id="tuned-nm">400 Nm</span></div>
          </div>
          <div class="power-item" style="background:#e8f5e9;border-color:#c8e6c9">
            <div class="label">Winst</div>
            <div class="value" id="gain-hp" style="color:#2e7d32">+35 hp</div>
            <div><span class="gain" id="gain-nm">+60 Nm</span></div>
          </div>
        </div>
        <div style="display:flex;gap:8px;margin-top:14px">
          <a href="/register" class="btn btn-primary" style="flex:1">Bestel tuning file • 1 credit</a>
          <a href="/tuning-specs" style="padding:10px 14px;border:1px solid var(--border);background:#fff;font-size:12px;font-weight:600;color:var(--text)">Bekijk ECU: <span id="ecu-name">Bosch EDC17C64</span></a>
        </div>
        <p style="font-size:11px;color:#78909c;margin-top:8px;text-align:center"><i class="fa fa-shield"></i> Safe & reliable • Tested on dyno • V-Max optional</p>
      </div>
      <p id="hp-error" style="display:none;margin-top:12px;padding:10px;background:#ffebee;color:#c62828;border:1px solid #ffcdd2;font-size:12px">Tuning file is not available. We're working on this in our R&D department.</p>
    </div>
  </div>
</div>

<div class="stats">
  <div class="stats-inner">
    <div><div class="stat-number">14</div><div class="stat-label">Years of experience</div></div>
    <div><div class="stat-number">15k+</div><div class="stat-label">File transfers a month</div></div>
    <div><div class="stat-number">80k+</div><div class="stat-label">Files in our database</div></div>
    <div><div class="stat-number">22</div><div class="stat-label">Engineers</div></div>
  </div>
</div>

