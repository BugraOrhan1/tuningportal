<%- include('partials/panel-layout', {title: 'New file service | ' + (brand ? brand.full : 'REVBOOST')}) %>
<div class="Crumbs">
  <div class="Crumbs__links"><p><span><a href="/account"><i class="fa fa-home"></i></a></span> <span class="sep">></span> <span><a href="/account/file-services">File services</a></span> <span class="sep">></span> <span>New file service</span></p></div>
</div>
<h1>New file service</h1>

<div class="Notice Notice--error" id="creditWarning" style="display:none"><div>You do not have sufficient credits to submit a new file service. <a href="/account/buy-credits">Please buy more credits first.</a></div></div>

<div class="EstimatedBanner button-color">
  <div class="EstimatedBanner__title">The estimated delivery time is</div>
  <div class="EstimatedBanner__duration">5 minutes - 10 minutes</div>
</div>

<!-- Exact form from dashboard.fast-chiptuningfiles.com export — adapted for REVBOOST with exact field names vehicle[make_id] + data-type-loader -->
<form method="POST" action="/api/file-services" enctype="multipart/form-data" id="file-service" data-type-loader-url="/api/v1/type-loader" data-type-loader-error="An error occurred while fetching data. Please try again later." novalidate>
  <input type="hidden" name="_token" value="<%= typeof csrf !== 'undefined' ? csrf : '' %>">
  <input type="hidden" name="__referrer" value="">
  <input type="hidden" name="__form" value="8fa8b4201a324a1682cca0373d0fc241da29ab1d">

  <!-- Vehicle — exact as export -->
  <div class="Block">
    <div class="Block__header">Vehicle</div>
    <div class="Block__content">
      <div class="Form flex">
        <div class="fld fld_2 form-group">
          <label for="vehicle[make_id]" class="control-label required">Make</label>
          <select class="form-control border" data-type-loader="make" required="required" id="vehicle[make_id]" name="vehicle[make_id]"><option value="" selected="selected">Make your choice</option><option value="other">Otherwise, namely</option></select>
        </div>
        <div class="fld fld_2 form-group">
          <label for="vehicle[model_id]" class="control-label required">Model</label>
          <select class="form-control border" data-type-loader="model" required="required" id="vehicle[model_id]" name="vehicle[model_id]"><option value="" selected="selected">Make your choice</option><option value="other">Otherwise, namely</option></select>
        </div>
        <div class="fld fld_2 form-group">
          <label for="vehicle[generation_id]" class="control-label required">Generation</label>
          <select class="form-control border" data-type-loader="generation" required="required" id="vehicle[generation_id]" name="vehicle[generation_id]"><option value="" selected="selected">Make your choice</option><option value="other">Otherwise, namely</option></select>
        </div>
        <div class="fld fld_3 form-group">
          <label for="vehicle[engine_id]" class="control-label required">Engine</label>
          <select class="form-control border" data-type-loader="engine" required="required" id="vehicle[engine_id]" name="vehicle[engine_id]"><option value="" selected="selected">Make your choice</option><option value="other">Otherwise, namely</option></select>
        </div>
        <div class="fld fld_3 form-group">
          <label for="vehicle[ecu_id]" class="control-label required">ECU</label>
          <select class="form-control border" data-type-loader="ecu" required="required" id="vehicle[ecu_id]" name="vehicle[ecu_id]"><option value="" selected="selected">Make your choice</option><option value="other">Otherwise, namely</option></select>
        </div>

        <div class="fld fld_2" data-usable='{"urlname":"vehicle/make","fields":[{"path":"make_id","values":["other"],"not":false}],"operator":"and","style":"hidden"}'>
          <div class="form-group"><input class="form-control border" maxlength="255" name="vehicle[make]" type="text" placeholder="Specify make (if otherwise)"></div>
        </div>
        <div class="fld fld_2" data-usable='{"urlname":"vehicle/model","fields":[{"path":"model_id","values":["other"],"not":false}],"operator":"and","style":"hidden"}'>
          <div class="form-group"><input class="form-control border" maxlength="255" name="vehicle[model]" type="text" placeholder="Specify model"></div>
        </div>
        <div class="fld fld_2" data-usable='{"urlname":"vehicle/generation","fields":[{"path":"generation_id","values":["other"],"not":false}],"operator":"and","style":"hidden"}'>
          <div class="form-group"><input class="form-control border" maxlength="255" name="vehicle[generation]" type="text" placeholder="Specify generation"></div>
        </div>
        <div class="fld fld_3" data-usable='{"urlname":"vehicle/engine","fields":[{"path":"engine_id","values":["other"],"not":false}],"operator":"and","style":"hidden"}'>
          <div class="form-group"><input class="form-control border" maxlength="255" name="vehicle[engine]" type="text" placeholder="Specify engine"></div>
        </div>
        <div class="fld fld_3" data-usable='{"urlname":"vehicle/ecu","fields":[{"path":"ecu_id","values":["other"],"not":false}],"operator":"and","style":"hidden"}'>
          <div class="form-group"><input class="form-control border" maxlength="255" name="vehicle[ecu]" type="text" placeholder="Specify ECU"></div>
        </div>

        <div class="fld fld_12">
          <div class="form-group"><div class="form-control-static"><a href="#" id="view_power_increase" class="view-power-increase link-color" style="display:none">View power increase</a></div></div>
        </div>

        <div class="fld fld_2" data-usable='{"urlname":"vehicle/vehicle_type","fields":[{"path":"make_id","values":["other"],"not":false}],"operator":"and","style":"hidden"}'>
          <label class="control-label">Vehicle type<span class="optional">(optional)</span></label>
          <select class="form-control border" name="vehicle[vehicle_type]"><option value="" selected="selected">Make your choice</option><option value="car">Car</option><option value="truck">Truck</option><option value="agriculture">Agriculture</option><option value="bikes">Bike</option><option value="boats">Boat</option></select>
        </div>

        <div class="fld fld_6"><label class="control-label required">Engine HP<span class="optional">(optional)</span></label><div class="form-group"><input class="form-control border" name="vehicle[power_hp]" type="number" id="vehicle[power_hp]" min="1" max="10000" placeholder="e.g. 150"></div></div>
        <div class="fld fld_6"><label class="control-label required">Engine kW<span class="optional">(optional)</span></label><div class="form-group"><input class="form-control border" name="vehicle[power_kw]" type="number" id="vehicle[power_kw]" min="1" max="10000" placeholder="e.g. 110"></div></div>

        <div class="fld fld_6 form-group">
          <label for="vehicle[year]" class="control-label required">Year</label>
          <select class="form-control border" name="vehicle[year]" required="required" id="vehicle[year]"><option value="" selected="selected">Make your choice</option><% for(let y=2026;y>=1990;y--){ %><option value="<%= y %>"><%= y %></option><% } %></select>
        </div>
        <div class="fld fld_6 form-group">
          <label for="vehicle[gearbox_id]" class="control-label required">Gearbox</label>
          <select class="form-control border" name="vehicle[gearbox_id]" required="required" id="vehicle[gearbox_id]"><option value="" selected="selected">Make your choice</option><% (tuningData.gearboxes||[]).forEach((g,i)=>{ %><option value="<%= 1826+i %>" data-name="<%= g %>"><%= g %></option><% }) %><option value="other">Otherwise, namely</option></select>
        </div>
        <div class="fld fld_6"><label class="control-label">License plate<span class="optional">(optional)</span></label><div class="form-group"><input class="form-control border" name="vehicle[license_plate]" maxlength="20" placeholder="XX-XX-XX"></div></div>
        <div class="fld fld_6"><label class="control-label">VIN<span class="optional">(optional)</span></label><div class="form-group"><input class="form-control border" name="vehicle[vin]" minlength="17" maxlength="17" placeholder="17 characters"></div></div>
        <div class="fld fld_12 form-group">
          <label class="control-label">Octane rating<span class="optional">(optional)</span></label>
          <select class="form-control border" name="vehicle[octane_rating]"><option value="" selected="selected">Make your choice</option><option value="91AKI / 95RON">91AKI / 95RON</option><option value="93AKI / 98RON">93AKI / 98RON</option><option value="95AKI / 102RON">95AKI / 102RON</option><option value="Racegas 100+ RON / 105+ RON">Racegas 100+ RON / 105+ RON</option></select>
          <input type="hidden" name="vehicle[octane_rating_required]" value="0">
        </div>
      </div>
    </div>
  </div>

  <!-- ECU details — exact -->
  <div class="Block">
    <div class="Block__header">ECU details</div>
    <div class="Block__content">
      <div class="Form flex">
        <div class="fld fld_3 form-group">
          <label class="control-label required">Tool type</label>
          <select class="form-control border" name="tuning[tool_type]" required="required"><option value="" selected="selected">Make your choice</option><option value="master">Master</option><option value="slave">Slave</option></select>
        </div>
        <div class="fld fld_3 form-group">
          <label class="control-label required">Read method</label>
          <select class="form-control border" name="tuning[read_method_id]" required="required" id="tuning[read_method_id]"><option value="" selected="selected">Make your choice</option><% (tuningData.readMethods||[]).forEach(m=>{ %><option value="<%= m %>"><%= m %></option><% }) %></select>
        </div>
        <div class="fld fld_6 fld_spacer"></div>
        <div class="fld fld_6" data-usable='{"urlname":"tuning/read_method_other","fields":[{"path":"read_method_id","values":["other","Otherwise, namely"],"not":false}],"operator":"and","style":"hidden"}'><label class="control-label required">Read method</label><div class="form-group"><input class="form-control border" name="tuning[read_method_other]" placeholder="Specify read method"></div></div>
        <div class="fld fld_6 fld_spacer" data-usable='{"urlname":"tuning/spacer_2","fields":[{"path":"read_method_id","values":["other","Otherwise, namely"],"not":false}],"operator":"and","style":"hidden"}'></div>
        <div class="fld fld_3"><label class="control-label">Hardware number<span class="optional">(optional)</span></label><div class="form-group"><input class="form-control border" name="tuning[hardware_number]" placeholder="e.g. 028101XXXX"></div></div>
        <div class="fld fld_3"><label class="control-label">Software number<span class="optional">(optional)</span></label><div class="form-group"><input class="form-control border" name="tuning[software_number]" placeholder="e.g. 1039XXXXXX"></div></div>
      </div>
    </div>
  </div>

  <!-- Tuning type — exact with credits -->
  <div class="Block">
    <div class="Block__header">Tuning type</div>
    <div class="Block__content">
      <div class="Form flex">
        <div class="RadioWrapper fld fld_6 form-group">
          <fieldset class="border" style="border:1px solid var(--border);padding:12px">
            <% tuningTypes.forEach(t=>{ %>
              <div class="fld fld_12"><label class="FancyRadio"><input class="border" type="radio" name="type[tuning_type_id]" value="<%= t.id %>" required><span></span><span><%= t.label %></span></label></div>
            <% }) %>
          </fieldset>
        </div>
        <div class="fld fld_12" id="tuningOptionsContainer" style="display:none">
          <h5 class="fld__label" style="margin:12px 0 8px;font-size:13px">Optional tuning options</h5>
          <div id="tuningOptionsGrid" style="display:grid;grid-template-columns:repeat(3,1fr);gap:10px"></div>
        </div>
        <!-- Exact option groups from export will be injected here via JS based on tuning_type_id, using same names type[option_group_...] -->
      </div>
    </div>
  </div>

  <!-- File to modify — exact with Vue single-uploader structure but also fallback file inputs for REVBOOST -->
  <div class="Block">
    <div class="Block__header">File to modify</div>
    <div class="Block__content">
      <div class="Form flex">
        <div class="fld fld_12 FileUploader WordBreak">
          <div class="form-group">
            <label for="file[original_asset_id]" class="control-label required">File to modify</label>
            <div class="FileUploader__info">Only files smaller than 20MB</div>
            <div class="FileUploader-file border border-radius-medium" id="dropOriginal" style="border:1px dashed var(--border);padding:20px;text-align:center;background:#fafafa;cursor:pointer">
              <div style="width:40px;height:40px;background:var(--primary);margin:0 auto 10px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff"><i class="fa fa-plus"></i></div>
              <div style="font-size:12px;color:#78909c" id="originalFileName">Drop your file(s) here or click to browse</div>
              <input type="file" id="originalFile" name="file[original_asset_id]" style="display:none" accept=".bin,.hex,.ori,.mod,.zip,.rar">
              <input type="hidden" name="file[original_asset_id]_hidden" value="">
            </div>
          </div>
        </div>
        <div class="fld fld_12 FileUploader WordBreak" data-usable='{"urlname":"file/tcu_asset_id","fields":[{"path":"/type/tuning_type_id","values":[]}],"operator":"or","style":"hidden"}' id="wrap_tcu_file">
          <div class="form-group">
            <label for="file[tcu_asset_id]" class="control-label">TCU file</label>
            <div class="FileUploader__info">Only files smaller than 20MB</div>
            <div class="FileUploader-file border" id="dropTcu" style="border:1px dashed var(--border);padding:20px;text-align:center;background:#fafafa;cursor:pointer">
              <div style="width:40px;height:40px;background:#263238;margin:0 auto 10px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff"><i class="fa fa-plus"></i></div>
              <div style="font-size:12px;color:#78909c" id="tcuFileName">Drop your TCU file here</div>
              <input type="file" id="tcuFile" name="file[tcu_asset_id]" style="display:none">
            </div>
          </div>
        </div>
        <div class="fld fld_12">
          <h5 class="fld__label fld--no-margin"><label for="file[attachments]" class="control-label">Optional attachments <i class="fa fa-info-circle" tabindex="0" data-tooltip="Extra files that can be used for tuning the file. Such as data logs, dynographs, or DTC reports."></i><span class="optional">(optional)</span></label></h5>
          <div class="FileUploader__info">Only files smaller than 20MB</div>
          <div id="attachmentsList" style="border:1px solid var(--border);min-height:60px;padding:10px;background:#fafafa;margin-bottom:10px;display:none"></div>
          <div class="FileUploader FileUploader--bar" id="dropAttachments" style="border:1px dashed var(--border);padding:14px;text-align:center;background:#fff;cursor:pointer">
            <span style="font-size:12px">Drop your file(s) here</span> <button type="button" class="btn btn-ghost" style="padding:6px 12px;font-size:11px;margin-left:8px">or click to browse</button>
            <input type="file" id="attachments" name="file[attachments][]" multiple style="display:none">
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modified parts — exact -->
  <div class="Block">
    <div class="Block__header">Modified parts</div>
    <div class="Block__content">
      <div class="Form flex">
        <div class="fld fld_7 form-group">
          <label class="control-label required">Does the car have modified parts?</label>
          <select class="form-control border" name="modified_parts_form[has_modified_parts]" required="required" id="modified_parts_form[has_modified_parts]"><option value="" selected="selected">Make your choice</option><option value="1">Yes</option><option value="0">No</option></select>
        </div>
        <div class="fld fld_7" data-usable='{"urlname":"modified_parts_form/notice","fields":[{"path":"has_modified_parts","values":["1"],"not":false}],"operator":"and","style":"hidden"}' id="wrap_modified_notice">
          <div class="Notice Notice--neutral"><div>In order to provide you with the best possible service, we would like to ask you to complete the list below in as much detail as possible.</div></div>
        </div>
        <div class="fld fld_12" data-usable='{"urlname":"modified_parts_form/modified_parts","fields":[{"path":"has_modified_parts","values":["1"],"not":false}],"operator":"and","style":"hidden"}' id="wrap_modified_parts">
          <div class="Form flex">
            <div class="fld fld_12 form-group"><label class="FancyCheckbox"><input type="checkbox" name="modified_parts_form[modified_parts][modified_parts_installed?][modified]" value="1"> <span></span> <span>modified parts installed? <i class="fa fa-info-circle"></i></span></label></div>
            <div class="fld fld_12" data-usable='{"urlname":"modified_parts_form/modified_parts/modified_parts_installed?/remarks","fields":[{"path":"modified","values":["1"],"not":false}],"operator":"and","style":"hidden"}' id="wrap_modified_remarks"><label class="control-label">Remarks<span class="optional">(optional)</span></label><div class="form-group"><textarea class="form-control border" name="modified_parts_form[modified_parts][modified_parts_installed?][remarks]" rows="3"></textarea></div></div>
          </div>
        </div>
        <div class="fld fld_12" data-usable='{"urlname":"modified_parts_form/modified_parts_remarks","fields":[{"path":"has_modified_parts","values":["1"],"not":false}],"operator":"and","style":"hidden"}' id="wrap_modified_parts_remarks">
          <label class="control-label">Remarks<span class="optional">(optional)</span></label>
          <div class="form-group"><textarea class="form-control border" name="modified_parts_form[modified_parts_remarks]" rows="3" placeholder="Specify exhaust, turbo, intercooler, etc."></textarea></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Service — exact -->
  <div class="Block">
    <div class="Block__header">Service</div>
    <div class="Block__content">
      <div class="Form flex">
        <div class="fld fld_6 form-group">
          <label class="control-label required">Time frame</label>
          <select class="form-control border" name="extra[time_frame]" required="required"><option value="" selected="selected">Make your choice</option><option value="asap">ASAP</option><option value="max_3">2-3 hours</option><option value="max_6">5-6 hours</option></select>
        </div>
        <div class="fld fld_12"><label class="control-label">Info<span class="optional">(optional)</span></label><div class="form-group"><textarea class="form-control border" name="extra[info]" rows="3" placeholder="Additional info for engineer (e.g. pops loud, v-max limited to 250)..."></textarea></div></div>
        <div class="fld fld_12 form-group"><label class="FancyCheckbox"><input type="checkbox" name="extra[terms_and_conditions]" value="1" required="required"> <span></span> <span>I have read and agree to the <a href="/legal/terms-and-conditions" target="_blank">Terms and conditions</a></span></label></div>
        <div class="fld fld_12 form-group"><label class="FancyCheckbox"><input type="checkbox" name="extra[refund_policy]" value="1" required="required"> <span></span> <span>I have read and agree to the <a href="/legal/refund-policy" target="_blank">Refund policy</a></span></label></div>
      </div>
    </div>
  </div>

  <div style="display:flex;gap:12px;justify-content:flex-end;margin-top:16px">
    <a href="/account/file-services" class="btn btn-ghost">Cancel</a>
    <button type="submit" class="btn btn-primary" id="submitBtn" style="min-width:160px">Submit file service</button>
  </div>
  <div id="submitError" class="error-box" style="display:none;margin-top:12px"></div>
</form>

<script>
const tuningData = <%- JSON.stringify(tuningData) %>;
const vehiclesData = <%- JSON.stringify(vehicles) %>;
</script>
<!-- Include exact export JS for type-loader + our handler -->
<script src="/js/cms/app.js" defer></script>

<%- include('partials/panel-footer') %>
