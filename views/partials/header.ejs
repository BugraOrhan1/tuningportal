<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' ? title : (brand ? brand.full : 'DASHFIX') + ' | Chiptuning files & ECU Tuning — Unieke Performance' %></title>
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="topbar">
  <div class="topbar-inner">
    <div class="topbar-left">
      <span><i class="fa fa-envelope"></i> <%= brand ? brand.email : 'info@dashfix.nl' %></span>
      <span><i class="fa fa-phone"></i> <%= brand ? brand.phone : '+31 85 060 00 33' %></span>
      <span style="background:var(--primary);color:#fff;padding:2px 6px;font-size:10px;letter-spacing:.5px">UNIEK MERK • GEEN KOPIE</span>
    </div>
    <div class="topbar-right">
      <span style="font-size:11px;color:#78909c">NL • EN • DE</span>
    </div>
  </div>
</div>
<script>
// Fallback: if token in localStorage but no cookie, set cookie for server-side auth (fixes preview same-site issues)
try{
  const t=localStorage.getItem('token');
  if(t && !document.cookie.includes('token=')){
    const isHttps = location.protocol === 'https:';
    document.cookie='token='+t+'; path=/; max-age=604800; SameSite=Lax' + (isHttps ? '; Secure' : '');
    if(isHttps) document.cookie='token='+t+'; path=/; max-age=604800; SameSite=None; Secure';
  }
  // If server says not logged in but token exists, try to refresh UI
  const hasToken=!!localStorage.getItem('token');
  window._mijndomeinToken=hasToken?t:null;
}catch(e){}
</script>
<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="logo">
      <div style="width:38px;height:38px;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;border-radius:4px;font-size:18px">RB</div>
      <div class="logo-text"><%= brand ? brand.name : 'DASHFIX' %><span style="font-weight:400;color:#78909c;font-size:13px"> PERFORMANCE</span></div>
    </a>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/#prijzen">Prijzen</a></li>
      <li><a href="/tuning-specs">Tuning specs</a></li>
      <li><a href="/#over">Over ons</a></li>
      <li><a href="/#contact">Contact</a></li>
    </ul>
    <div style="display:flex;gap:8px;align-items:center">
      <% if (user) { %>
        <a href="/account" class="btn btn-primary" style="padding:8px 14px;font-size:12px"><i class="fa fa-dashboard"></i> File Panel</a>
        <a href="/logout" style="font-size:12px;color:#78909c">Logout</a>
        <div class="Avatar" style="width:30px;height:30px;font-size:11px"><%= user.name.split(' ').map(n=>n[0]).join('').substring(0,2).toUpperCase() %></div>
      <% } else { %>
        <a href="/login" class="btn btn-ghost" style="padding:8px 16px;font-size:12px">Inloggen</a>
        <a href="/register" class="btn btn-primary" style="padding:8px 16px;font-size:12px">Registreren</a>
      <% } %>
    </div>
  </div>
</nav>
