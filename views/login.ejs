<%- include('partials/header') %>
<div class="auth-wrap">
  <div class="auth-card">
    <h1>Inloggen — <%= brand ? brand.name : 'DASHFIX' %></h1>
    <p>Log in bij je <strong><%= brand ? brand.name : 'DASHFIX' %></strong> klanten file-panel. Alleen klanten met account hebben toegang tot file services. Uniek merk — alle autos via live API.</p>
    <% if (typeof error !== 'undefined' && error) { %><div class="error-box" style="display:block"><%= error %></div><% } %>
    <div id="error" class="error-box" style="display:none"></div>
    <form id="loginForm" action="/login" method="POST">
      <div class="form-group"><label>E-mail</label><input name="email" type="email" required placeholder="jouw@email.com" value="demo@dashfix.nl"></div>
      <div class="form-group"><label>Wachtwoord</label><input name="password" type="password" required placeholder="••••••••" value="demo123"></div>
      <input type="hidden" name="redirect" value="<%= redirect %>">
      <button class="btn btn-primary" style="width:100%" type="submit" id="loginBtn">Inloggen</button>
      <div id="loginDebug" style="font-size:11px;color:#78909c;margin-top:8px;display:none"></div>
    </form>
    <p style="margin-top:14px;text-align:center;font-size:12px">Nog geen account? <a href="/register">Registreren</a> • <a href="/">Terug naar website</a></p>
    <div style="margin-top:16px;padding:10px;background:#fff3ef;border:1px solid #ffccb3;font-size:11px"><strong>Demo account:</strong><br>klik direct op Inloggen met demo@dashfix.nl / demo123 (ook demo@revboost.nl werkt) — werkt ook via <a href="#" onclick="document.querySelector('[name=email]').value='demo@dashfix.nl';document.querySelector('[name=password]').value='demo123';document.getElementById('loginForm').submit();return false;">één klik</a></div>
  </div>
</div>
<script>
(function(){
  const form=document.getElementById('loginForm');
  const errBox=document.getElementById('error');
  const btn=document.getElementById('loginBtn');
  const debug=document.getElementById('loginDebug');
  // Show debug info
  debug.style.display='block';
  debug.textContent='JS actief — formulier wordt via normale POST verstuurd (meest betrouwbaar). Als inloggen blijft hangen, check of cookies aan staan.';
  form.addEventListener('submit', function(e){
    // Laat browser gewoon POST naar /login doen — dat is het meest betrouwbaar voor preview iframe
    // Alleen tonen we loading state, en proberen we daarnaast ook via fetch voor snellere feedback
    const fd = new FormData(form);
    const email = fd.get('email'), password = fd.get('password');
    if(!email || !password) return; // laat browser required tonen
    btn.disabled=true; btn.textContent='Inloggen...';
    debug.textContent='Bezig met inloggen... (via /login POST)';
    // We laten de normale POST doorgaan — niet preventDefault, dus browser volgt 302 naar /account
    // Alleen als fetch beschikbaar is, proberen we parallel ook token in localStorage te zetten voor API calls
    try{
      fetch('/api/auth/login', {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({email: email, password: password, redirect: fd.get('redirect')||'/account'}), credentials:'include'})
        .then(r=>r.json()).then(data=>{
          if(data.token){
            try{ localStorage.setItem('token', data.token); }catch{}
            const isHttps = location.protocol === 'https:';
            document.cookie = 'token='+data.token+'; path=/; max-age=604800; SameSite=Lax' + (isHttps ? '; Secure' : '');
            if(isHttps) document.cookie = 'token='+data.token+'; path=/; max-age=604800; SameSite=None; Secure';
            debug.textContent='Token ontvangen, cookie gezet — wordt doorgestuurd naar '+ (data.redirect||'/account');
          }
        }).catch(()=>{});
    }catch{}
    // Niet preventDefault — laat form gewoon submitten
  });
  // Als er al een token in localStorage is maar geen cookie, probeer te herstellen
  try{
    const t=localStorage.getItem('token');
    if(t && !document.cookie.includes('token=')){
      const isHttps = location.protocol === 'https:';
      document.cookie='token='+t+'; path=/; max-age=604800; SameSite=Lax' + (isHttps ? '; Secure' : '');
      if(isHttps) document.cookie='token='+t+'; path=/; max-age=604800; SameSite=None; Secure';
      debug.textContent='Hersteld token uit localStorage — probeer opnieuw in te loggen of ga naar /account';
    }
  }catch{}
})();
</script>
<%- include('partials/footer') %>
